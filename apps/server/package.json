{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@hono/trpc-server": "^0.4.2",
		"@tachyon-webstore/api": "workspace:*",
		"@tachyon-webstore/auth": "workspace:*",
		"@tachyon-webstore/db": "workspace:*",
		"@tachyon-webstore/env": "workspace:*",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"stripe": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tachyon-webstore/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.22.14",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"supabase"
	]
}
