# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (packages/db) and Better-Auth.
# For the local Supabase stack bundled in packages/db/supabase:
#   supabase start
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Authentication (Better-Auth) ─────────────────────────────────────────────
# 32+ character secret used to sign session cookies.
BETTER_AUTH_SECRET="replace-with-a-random-string-of-at-least-32-chars"
# Public base URL of this API server.
BETTER_AUTH_URL="http://localhost:3000"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origin of the Next.js web app allowed to call this server.
CORS_ORIGIN="http://localhost:3001"

# ── Stripe ───────────────────────────────────────────────────────────────────
# Test key from the Stripe dashboard (Developers > API keys).
STRIPE_SECRET_KEY="sk_test_replace_me"
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Hono API server binds to (defaults to 3000).
PORT="3000"

# ── Misc ─────────────────────────────────────────────────────────────────────
# Set to true in CI to skip t3-env validation (e.g. during prisma generate).
# SKIP_ENV_VALIDATION="true"
